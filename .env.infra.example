# Copy to .env.infra (gitignored), fill in values, then `source .env.infra` before running terraform

# Fly.io
export TF_VAR_fly_org=
export FLY_API_TOKEN=
export TF_VAR_fly_api_ip=

# Cloudflare
export TF_VAR_cf_account_id=
export TF_VAR_cf_zone_id=
export TF_VAR_cf_api_token=

# Cloudflare R2 (Terraform remote state)
export TF_VAR_r2_access_key_id=
export TF_VAR_r2_secret_access_key=
export AWS_ACCESS_KEY_ID=        # same as r2_access_key_id
export AWS_SECRET_ACCESS_KEY=    # same as r2_secret_access_key

# Neon
export TF_VAR_neon_api_key=
export TF_VAR_neon_org_id=

# Upstash
export TF_VAR_upstash_email=
export TF_VAR_upstash_api_key=
