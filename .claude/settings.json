{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(make check*)",
      "Bash(scripts/check.sh*)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go run ./cmd/*)",
      "Bash(gofmt *)",
      "Bash(npx tsc *)",
      "Bash(npm run build)",
      "Bash(npm run dev*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose up *)",
      "Bash(docker compose logs *)",
      "Bash(docker port *)",
      "Bash(docker exec fantasy-league-01-*)",
      "Bash(lsof -iTCP*)",
      "Bash(make run)",
      "Bash(make migrate-up)",
      "Bash(curl -s localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.tfvars)",
      "Read(**/terraform.tfstate*)",
      "Read(~/.claude/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/*.tfvars)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(fly deploy*)",
      "Bash(flyctl deploy*)",
      "Bash(fly secrets *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * main)",
      "Bash(git push origin main*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prompt-context.sh"
          }
        ]
      }
    ]
  }
}
